{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zilobase-background",
  // Community entry: copy this template next to your background entry (see background.template.ts)
  // and replace every <PLACEHOLDER> before deploying.
  "main": "<BACKGROUND_ENTRY>",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
    },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 },
  },
  "upload_source_maps": true,
  "secrets": {
    "required": [
      "CALENDAR_GOOGLE_CLIENT_ID",
      "CALENDAR_GOOGLE_CLIENT_SECRET",
      "CALENDAR_TOKEN_ENCRYPTION_KEY",
      "AUTOMATION_SECRET_ENCRYPTION_KEY",
    ],
  },
  "alias": {
    "better-auth/adapters/drizzle": "../zilobase/node_modules/better-auth/dist/adapters/drizzle-adapter/index.mjs",
    "better-auth/plugins": "../zilobase/node_modules/better-auth/dist/plugins/index.mjs",
    "better-auth": "../zilobase/node_modules/better-auth/dist/index.mjs",
    "drizzle-orm/node-postgres": "../zilobase/node_modules/drizzle-orm/node-postgres/index.js",
    "drizzle-orm/pg-core": "../zilobase/node_modules/drizzle-orm/pg-core/index.js",
    "drizzle-orm": "../zilobase/node_modules/drizzle-orm/index.js",
    "pg": "../zilobase/node_modules/pg/esm/index.mjs",
    "yjs": "./node_modules/yjs/dist/yjs.mjs",
  },
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [
      { "binding": "AI_RUNS", "queue": "zilobase-ai-runs" },
      { "binding": "SEARCH_INDEXING", "queue": "zilobase-search-indexing" },
      { "binding": "BACKGROUND_FAST", "queue": "zilobase-background-fast" },
      { "binding": "AUTOMATION_RUNS", "queue": "zilobase-automation-runs" },
      { "binding": "CALENDAR_JOBS", "queue": "zilobase-calendar-jobs" },
    ],
    "consumers": [
      {
        "queue": "zilobase-ai-runs",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_concurrency": 4,
        "max_retries": 5,
        "dead_letter_queue": "zilobase-ai-runs-dlq",
      },
      {
        "queue": "zilobase-ai-runs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 2,
        "max_retries": 100,
      },
      {
        "queue": "zilobase-search-indexing",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_concurrency": 4,
        "max_retries": 5,
        "dead_letter_queue": "zilobase-search-indexing-dlq",
      },
      {
        "queue": "zilobase-search-indexing-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 5,
        "max_retries": 100,
      },
      {
        "queue": "zilobase-background-fast",
        "max_batch_size": 20,
        "max_batch_timeout": 1,
        "max_concurrency": 20,
        "max_retries": 5,
        "dead_letter_queue": "zilobase-background-fast-dlq",
      },
      {
        "queue": "zilobase-automation-runs",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_concurrency": 20,
        "max_retries": 8,
        "dead_letter_queue": "zilobase-automation-runs-dlq",
      },
      {
        "queue": "zilobase-calendar-jobs",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_concurrency": 10,
        "max_retries": 8,
        "dead_letter_queue": "zilobase-calendar-jobs-dlq",
      },
      {
        "queue": "zilobase-background-fast-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 5,
        "max_retries": 100,
      },
      {
        "queue": "zilobase-automation-runs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 5,
        "max_retries": 100,
      },
      {
        "queue": "zilobase-calendar-jobs-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_concurrency": 5,
        "max_retries": 100,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PAGE_COLLABORATION",
        "class_name": "PageCollaborationRoom",
        "script_name": "zilobase-server",
      },
      {
        "name": "DATABASE_COLLABORATION",
        "class_name": "DatabaseCollaborationRoom",
        "script_name": "zilobase-server",
      },
      {
        "name": "MEETING_COLLABORATION",
        "class_name": "MeetingCollaborationRoom",
        "script_name": "zilobase-server",
      },
      {
        "name": "CALENDAR_NOTIFICATION_ROOM",
        "class_name": "CalendarNotificationRoom",
        "script_name": "zilobase-server",
      },
      {
        "name": "NAVIGATION_NOTIFICATION_ROOM",
        "class_name": "NavigationNotificationRoom",
        "script_name": "zilobase-server",
      },
    ],
  },
  "placement": { "mode": "targeted", "region": "<CLOUDFLARE_PLACEMENT_REGION>" },
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }],
  "r2_buckets": [
    {
      "binding": "IMAGE_BUCKET",
      "bucket_name": "<R2_BUCKET_NAME>",
      "preview_bucket_name": "<R2_PREVIEW_BUCKET_NAME>",
    },
  ],
  "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["<NO_REPLY_EMAIL>"] }],
  // GEMINI_API_KEY is conditional: required in API and background environments only when enabled.
  "vars": {
    "SEARCH_EMBEDDINGS_ENABLED": "false",
    "SEARCH_EMBEDDING_QUOTA_SCOPE": "default:gemini-embedding-2",
    "SEARCH_EMBEDDING_RPM": "30",
    "SEARCH_EMBEDDING_TPM": "100000",
    "SEARCH_EMBEDDING_DAILY_TOKENS": "10000000",
    "SEARCH_EMBEDDING_WORKSPACE_DAILY_TOKENS": "1000000",
    "BETTER_AUTH_URL": "<API_ORIGIN>",
    "CLIENT_URL": "<WEB_ORIGIN>",
    "DATABASE_AUTOMATIONS_ENABLED": "false",
    "DATABASE_AUTOMATIONS_EXECUTION_DISABLED": "false",
    "AUTOMATION_WEBHOOKS_ENABLED": "false",
    "AUTOMATION_SLACK_ENABLED": "false",
    "EMAIL_FROM": "Zilobase <<NO_REPLY_EMAIL>>",
    "IMAGE_STORAGE_MODE": "binding",
    "ZILOBASE_CELL_ID": "default",
    "ZILOBASE_RUNTIME_KIND": "worker",
    "ZILOBASE_ENVIRONMENT": "production",
  },
}
