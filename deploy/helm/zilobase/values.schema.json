{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "replicaCount",
    "development",
    "debug",
    "realtime",
    "image",
    "existingSecret",
    "config",
    "networkPolicy",
    "trustedCa",
    "queue",
    "node",
    "search"
  ],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 1
    },
    "development": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "debug": {
      "type": "object",
      "required": ["enabled", "port"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        }
      }
    },
    "realtime": {
      "type": "object",
      "required": ["existingSecret", "secretKey", "networkCIDR", "port"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "networkCIDR": {
          "type": "string",
          "minLength": 3
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "existingSecret": {
      "type": "string",
      "minLength": 1
    },
    "image": {
      "type": "object",
      "required": ["repository", "digest"],
      "properties": {
        "repository": {
          "const": "ghcr.io/zilobase/zilobase"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "config": {
      "type": "object",
      "required": ["externalUrl", "s3Endpoint", "s3PublicEndpoint", "s3Bucket", "smtpHost"],
      "properties": {
        "externalUrl": {
          "type": "string",
          "pattern": "^https?://"
        },
        "s3Endpoint": {
          "type": "string",
          "pattern": "^https?://"
        },
        "s3PublicEndpoint": {
          "type": "string",
          "pattern": "^https?://"
        },
        "s3Bucket": {
          "type": "string",
          "minLength": 1
        },
        "smtpHost": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "healthProbeCIDRs", "postgresCIDR", "s3CIDR", "smtpCIDR"],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "healthProbeCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "postgresCIDR": {
          "type": "string",
          "minLength": 3
        },
        "s3CIDR": {
          "type": "string",
          "minLength": 3
        },
        "smtpCIDR": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "trustedCa": {
      "type": "object",
      "required": ["configMapName", "key"],
      "properties": {
        "configMapName": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "queue": {
      "type": "object",
      "required": ["existingSecret", "secretKey", "networkCIDR", "port"],
      "properties": {
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "networkCIDR": {
          "type": "string",
          "minLength": 3
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "node": {
      "type": "object",
      "required": ["processRole", "backgroundLanes"],
      "properties": {
        "processRole": {
          "type": "string",
          "enum": ["all", "api", "worker"]
        },
        "backgroundLanes": {
          "type": "string"
        }
      }
    },
    "search": {
      "type": "object",
      "required": [
        "enabled",
        "existingSecret",
        "secretKey",
        "quotaScope",
        "requestsPerMinute",
        "tokensPerMinute",
        "deploymentDailyTokens",
        "workspaceDailyTokens",
        "concurrency",
        "egressCIDRs"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "existingSecret": {
          "type": "string",
          "minLength": 1
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        },
        "quotaScope": {
          "type": "string",
          "minLength": 1
        },
        "requestsPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "tokensPerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "deploymentDailyTokens": {
          "type": "integer",
          "minimum": 1
        },
        "workspaceDailyTokens": {
          "type": "integer",
          "minimum": 1
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "egressCIDRs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "development": {
            "properties": {
              "enabled": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "externalUrl": {
                "pattern": "^https://"
              },
              "s3Endpoint": {
                "pattern": "^https://"
              },
              "s3PublicEndpoint": {
                "pattern": "^https://"
              }
            }
          }
        }
      }
    }
  ]
}
